.map-page {
  min-height: 100vh;
  background: #f8fbf8;
  position: relative;
}

.map-tabs {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 24rpx;
  height: 78rpx;
  z-index: 5;
  border: 1rpx solid #e4ebe7;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.96);
  display: flex;
  overflow: hidden;
}

.map-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5e6864;
  font-size: 28rpx;
}

.map-tab-active {
  margin: 8rpx;
  border-radius: 12rpx;
  background: #31af62;
  color: #ffffff;
  font-weight: 800;
}

.spot-map {
  width: 100vw;
  height: 100vh;
}

.map-message {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  top: 128rpx;
  z-index: 6;
  padding: 22rpx 26rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid #e4ebe7;
  color: #53605a;
  font-size: 26rpx;
  line-height: 1.5;
}

.map-message.error {
  color: #c7423a;
}

.quick-link {
  margin-top: 14rpx;
  color: #168346;
  font-size: 26rpx;
  text-align: left;
}

.map-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 6;
  min-height: 260rpx;
  padding: 18rpx 32rpx 42rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 44rpx rgba(24, 42, 30, 0.1);
}

.sheet-handle {
  width: 84rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #d8dfda;
  margin: 0 auto 30rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
}

.sheet-title {
  flex: 1;
  color: #17241d;
  font-size: 34rpx;
  font-weight: 800;
}

.sheet-row {
  margin-top: 18rpx;
  color: #2f3c34;
  font-size: 28rpx;
}

.sheet-note {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #ecf8ef;
  color: #31503d;
  font-size: 26rpx;
}

.footprint-list {
  margin-top: 18rpx;
  max-height: 280rpx;
  overflow: auto;
}

.footprint-row {
  min-height: 96rpx;
  padding: 0 4rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #edf2ee;
}

.footprint-row:last-child {
  border-bottom: 0;
}

.footprint-main {
  flex: 1;
  min-width: 0;
}

.footprint-title {
  color: #243229;
  font-size: 28rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.footprint-meta {
  margin-top: 8rpx;
  color: #7d8984;
  font-size: 24rpx;
}

.privacy-hint {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #ecf8ef;
  color: #168346;
  font-size: 26rpx;
}

.record-status {
  min-width: 84rpx;
  height: 46rpx;
  border-radius: 12rpx;
  background: #e8f7ed;
  color: #168346;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}
