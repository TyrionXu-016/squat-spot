.records-page {
  padding-bottom: 44rpx;
}

.small-title {
  margin-top: 18rpx;
  font-size: 44rpx;
}

.tag-filter-scroll {
  margin: 34rpx -32rpx 0;
  white-space: nowrap;
}

.tag-filter-row {
  display: inline-flex;
  gap: 18rpx;
  padding: 0 32rpx;
}

.empty-card {
  margin-top: 28rpx;
  padding: 34rpx 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #7c8782;
  border: 1rpx solid #e6eee8;
}

.records-card {
  margin-top: 28rpx;
  overflow: hidden;
}

.record-row {
  min-height: 132rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #edf2ee;
}

.record-row:last-child {
  border-bottom: 0;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-title {
  font-size: 29rpx;
  font-weight: 800;
  color: #243229;
}

.record-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7c8782;
}

.record-note {
  margin-top: 8rpx;
  color: #4f5d57;
  font-size: 25rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 390rpx;
}

.record-status {
  min-width: 84rpx;
  height: 46rpx;
  border-radius: 12rpx;
  background: #e8f7ed;
  color: #168346;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 34, 27, 0.28);
  z-index: 20;
  display: flex;
  align-items: flex-end;
}

.detail-sheet {
  width: 100%;
  padding: 18rpx 32rpx 44rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
}

.sheet-handle {
  width: 84rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #d8dfda;
  margin: 0 auto 30rpx;
}

.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #17241d;
}

.detail-sub {
  margin-top: 8rpx;
  color: #7b8782;
  font-size: 26rpx;
}

.detail-row {
  margin-top: 28rpx;
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  color: #2c3a31;
  font-size: 28rpx;
}

.detail-label {
  color: #7d8984;
}

.detail-value {
  flex: 1;
  text-align: right;
}

.detail-note {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ecf8ef;
  color: #31503d;
  font-size: 27rpx;
  line-height: 1.5;
}

.delete-button {
  margin-top: 28rpx;
  height: 84rpx;
  border-radius: 16rpx;
  border: 1rpx solid #f1c4c0;
  color: #d94a42;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
