page {
  min-height: 100%;
  background: #f8fbf8;
  color: #15231b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  line-height: normal;
  background: transparent;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
}

.screen-title {
  font-size: 48rpx;
  line-height: 1.15;
  font-weight: 800;
  letter-spacing: 0;
  color: #126338;
}

.screen-subtitle {
  margin-top: 14rpx;
  color: #5d6864;
  font-size: 28rpx;
  line-height: 1.5;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #17241d;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e6eee8;
  border-radius: 16rpx;
}

.primary-button {
  height: 104rpx;
  border-radius: 16rpx;
  background: #31af62;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 34rpx rgba(49, 175, 98, 0.22);
}

.muted {
  color: #7a8581;
}

.status-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 999rpx;
  display: inline-block;
  margin-right: 10rpx;
}

.status-smooth {
  background: #35b86a;
}

.status-normal {
  background: #f2bd2b;
}

.status-hard {
  background: #f5655d;
}

.tag {
  min-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #dfe9e2;
  color: #4b5551;
  font-size: 26rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.tag-active {
  border-color: #29a85d;
  background: #ecf8ef;
  color: #168346;
  font-weight: 700;
}
